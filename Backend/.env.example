PORT=3001
FRONTEND_URL=http://localhost:3020

# Optional — when unset, rate limiting uses in-memory store
REDIS_URL=
CONTACT_WEBHOOK_URL=
APPLY_WEBHOOK_URL=

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
# Optional direct Postgres URL (otherwise derived from project URL + password)
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

NEXT_PUBLIC_SITE_URL=http://localhost:3020

# Bootstrap admin (used by npm run db:migrate)
ADMIN_EMAIL=admin@seedqura.com
ADMIN_PASSWORD=change-me

# --- Razorpay ----------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Resend ------------------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM=Seedqura <hello@seedqura.in>

# --- Google Calendar (Phase 2 sessions) --------------------------------------
# Service account JSON fields + a calendar shared with the service account
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
# Optional display timezone for session emails
SESSION_TIMEZONE=Asia/Kolkata
